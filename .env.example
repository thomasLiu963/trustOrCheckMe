# Copy to .env only when you are ready for explicitly authorized paid calls.
# Dataset preparation, tests, and dry runs do not require provider credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Google uses Vertex AI and Application Default Credentials, not an AI Studio key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global

# Optional: override the default Hugging Face cache location.
HF_HOME=
